---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceList from "../../components/SourceList.astro";
const services = [
  {
    name: "リクルートエージェント", type: "総合エージェント",
    url: "https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3778687&pid=892680702",
    officialUrl: "https://www.r-agent.com/", sourceUrl: "https://www.r-agent.com/",
    fee: "会員登録無料", approach: "公開求人を検索し、求人紹介・転職支援も検討する",
    condition: "希望職種・勤務地の求人内容と応募条件を個別に確認する",
    fit: "候補となる業界や職種を広く調べたい人",
    caution: "公開求人数の多さだけで、公務員経験に合う求人があるとは判断できません。",
    sourceLabel: "公式サイト：無料登録・公開求人検索", advertised: true
  },
  {
    name: "ビズリーチ", type: "スカウト・求人検索",
    url: "https://www.bizreach.jp/", officialUrl: "https://www.bizreach.jp/", sourceUrl: "https://www.bizreach.jp/faq/",
    fee: "無料プランと有料プランあり", approach: "企業・ヘッドハンターのスカウト、求人検索・応募",
    condition: "登録後に独自基準の審査あり。日本国内向けで、日本語でのやりとりが必要",
    fit: "経験を整理し、企業やヘッドハンターからの反応を確認したい人",
    caution: "無料・有料で利用機能が異なります。プロフィールの公開範囲とブロック設定も確認しましょう。",
    sourceLabel: "公式FAQ：プラン・審査・情報公開", advertised: false
  },
  {
    name: "JAC Recruitment", type: "ハイクラス・専門職エージェント",
    url: "https://www.jac-recruitment.jp/", officialUrl: "https://www.jac-recruitment.jp/", sourceUrl: "https://www.jac-recruitment.jp/faq/",
    fee: "求職者の利用料無料", approach: "コンサルタントによる求人紹介・転職支援",
    condition: "紹介可能な求人が用意できた時点で順次連絡。海外在住の場合は国・希望条件による制約あり",
    fit: "管理職や専門分野の経験をもとに相談したい人",
    caution: "経験・希望によっては求人紹介や支援を受けられない場合があります。",
    sourceLabel: "公式FAQ：費用・連絡・海外在住者の利用", advertised: false
  }
];
const sources = services.map(service => ({title: service.sourceLabel, publisher: service.name, url: service.sourceUrl}));
sources.push({title:"サービス紹介：支援対象と紹介条件", publisher:"JAC Recruitment", url:"https://www.jac-recruitment.jp/service/"});
---
<BaseLayout title="地方公務員向け転職サービス比較：費用・利用条件・選び方" description="リクルートエージェント、ビズリーチ、JAC Recruitmentの費用・利用方法・条件を公式情報で比較。登録せずに求人を調べる方法も紹介します。" updatedDate="2026-09-06">
<article class="container article">
<p class="eyebrow">SERVICES</p>
<h1>転職サービスを、目的と条件で比較する</h1>
<p class="lead">まず求人を調べたいのか、経験を整理して相談したいのか。必要な支援を決めてから、費用や利用条件を比べましょう。転職を決める前の情報収集から始められます。</p>
<div class="notice"><strong>広告について：</strong>リクルートエージェントの「登録ページを見る（広告）」には広告リンクを使用しています。公式情報の確認リンクは広告リンクと分けて表示しています。</div>
<h2>登録せずに、まず仕事内容を調べる</h2>
<p>候補職種が決まっていなければ、<a href="https://www.r-agent.com/">公式サイトの公開求人</a>や企業の採用ページで、仕事内容・必須経験・勤務地を確認できます。気になる求人を三つ選び、「経験が合う点」「学ぶ必要がある点」を書き出してみましょう。</p>
<div class="grid-list">
<a href="/articles/skill-map/"><b>経験を先に整理する</b><span>部署名を業務やスキルに分解する</span></a>
<a href="/articles/current-role-growth/"><b>現職で経験を積む</b><span>今の仕事で試せる改善を考える</span></a>
</div>
<h2 id="comparison">費用・利用方法・条件を比べる</h2>
<p>公式情報の確認日：<time datetime="2026-09-06">2026年9月6日</time>。以下はサービスの優劣や転職成功率のランキングではありません。提供内容は変更されるため、利用前に各社の案内を確認してください。</p>
<div class="table-scroll" role="region" aria-label="転職サービス比較表（横スクロール可能）" tabindex="0">
<table class="comparison-table">
<caption>主要3サービスの比較</caption>
<thead><tr><th scope="col">確認項目</th>{services.map(service => <th scope="col">{service.name}</th>)}</tr></thead>
<tbody>
<tr><th scope="row">費用</th>{services.map(service => <td>{service.fee}</td>)}</tr>
<tr><th scope="row">利用方法</th>{services.map(service => <td>{service.approach}</td>)}</tr>
<tr><th scope="row">利用・紹介条件</th>{services.map(service => <td>{service.condition}</td>)}</tr>
<tr><th scope="row">根拠</th>{services.map(service => <td><a href={service.sourceUrl}>{service.sourceLabel}</a></td>)}</tr>
</tbody>
</table>
</div>
<h2 id="major-services">自分に合う使い方と注意点</h2>
<p>以下の「検討する目的」は、公式のサービス内容をもとにした当サイトの提案です。公務員向けの転職実績や採用可能性を保証するものではありません。</p>
{services.map(service => (
<section class="service-card">
<div><p class="tag">{service.type}</p><h3>{service.name}</h3>
<p><strong>検討する目的：</strong>{service.fit}</p>
<p><strong>注意点：</strong>{service.caution}</p></div>
<div class="service-actions">
<a class="button" href={service.url} rel={service.advertised ? "nofollow sponsored" : undefined}>{service.advertised ? "登録ページを見る（広告）" : "公式サイトを見る"}</a>
<a class="text-link" href={service.sourceUrl}>条件・公式情報を確認する</a>
</div>
</section>
))}
<h2 id="before-register">登録・相談前に整理すること</h2>
<ul>
<li><strong>相談の目的：</strong>今すぐ応募したいのか、まず候補職種を知りたいのか。</li>
<li><strong>希望条件：</strong>勤務地、働き方、仕事内容など、優先する項目と相談できる項目。</li>
<li><strong>担当経験：</strong>業務名だけでなく、自分の役割・行動・確認できた成果。</li>
<li><strong>情報公開：</strong>経歴を誰が閲覧できるか、公開範囲や連絡方法をどう設定するか。</li>
<li><strong>支援が合わない場合：</strong>条件を見直す、他の求人を調べる、現職で経験を積むなど次の選択肢。</li>
</ul>
<p><a href="/articles/local-government-resume/">職務経歴書の土台を作る</a> · <a href="/learning/">不足する専門性を学ぶ</a></p>
<SourceList sources={sources} />
</article>
</BaseLayout>
