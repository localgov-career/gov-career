---
import "../styles/global.css";
const { title, description = "地方公務員から民間企業への転職情報サイト" } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | 地方公務員キャリア</title>
  <meta name="description" content={description} />
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">地方公務員<span>キャリア</span></a>
    <nav>
      <a href="/articles/behavioral-economics/">転職を考える前に</a>
      <a href="/articles/skill-map/">行政経験から探す</a>
      <a href="/articles/career-options/">職種から探す</a>
      <a href="/services/">転職サービス比較</a>
    </nav>
  </div>
</header>

<main>
  <slot />
</main>
<section class="site-navigation-links">
  <div class="container">
    <h2>次に読む</h2>

    <div class="grid-list">
      <a href="/articles/skill-map/">
        <b>行政経験から探す</b>
        <span>部署・スキルから転職先を見る</span>
      </a>

      <a href="/articles/career-options/">
        <b>職種から探す</b>
        <span>コンサル・DX・人事などの選択肢を見る</span>
      </a>

      <a href="/services/">
        <b>転職サービス比較</b>
        <span>求人情報を確認する</span>
      </a>
    </div>
  </div>
</section>
<footer>
  <div class="container footer-inner">
    <strong>地方公務員キャリア</strong>
    <p>行政経験を民間キャリアへ変換するための情報サイト。</p>
  </div>
</footer>
</body>
</html>
