  {
    name: "ビズリーチ",
    type: "ハイクラス・スカウト",
    url: "https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3778687&pid=892680701",
    officialUrl: "https://www.bizreach.jp/",
    trackingPixel: "https://ad.jp.ap.valuecommerce.com/servlet/gifbanner?sid=3778687&pid=892680701",
    actionText: "無料登録ページを見る",
    fit: "管理職経験、専門性、企画・マネジメント経験を市場で試したい人",
    admin: "企画・政策、財務・会計、情報・DX、土木・建築、管理職、専門職",
    point: "職務経歴を登録してスカウトを受けることで、自分の経験がどの企業に評価されるかを確認しやすいサービスです。"
  },
  {
    name: "JAC Recruitment",
    type: "ハイクラス・専門職エージェント",
    url: "https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3778687&pid=892680704",
    officialUrl: "https://www.jac-recruitment.jp/",
    trackingPixel: "https://ad.jp.ap.valuecommerce.com/servlet/gifbanner?sid=3778687&pid=892680704",
    actionText: "転職支援サービスを見る",
    fit: "管理職、専門職、技術職、外資・グローバル企業も含めて相談したい人",
    admin: "企画・政策、財務・会計、情報・DX、土木・建築、管理職、専門職",
    point: "ミドル・ハイクラスや専門職領域を中心に、職務経歴を整理しながら求人紹介を受けたい場合に検討しやすいサービスです。"
  }
];

const routes = [
  ["企画・政策", "リクルートエージェント / ビズリーチ / JAC Recruitment", "事業企画、公共領域コンサル、BtoG企業を比較する"],
  ["財務・会計", "リクルートエージェント / ビズリーチ / JAC Recruitment", "経理、財務、経営管理、管理部門求人を見る"],
  ["税務・徴収", "リクルートエージェント", "金融、審査、債権管理、コンプライアンス職を確認する"],
  ["福祉・介護・保健", "リクルートエージェント", "ヘルスケア、介護、福祉、人材、カスタマーサクセスを広く見る"],
  ["情報・DX", "リクルートエージェント / ビズリーチ / JAC Recruitment", "IT企画、DX推進、自治体向けSaaS求人を探す"],
  ["土木・建築", "リクルートエージェント / ビズリーチ / JAC Recruitment", "建設、インフラ、不動産、発注者支援の求人を見る"],
  ["管理職・専門職", "ビズリーチ / JAC Recruitment", "スカウトや専門エージェントで市場価値と年収レンジを確認する"]
];

const purposes = [
  {
    title: "初めて民間転職を考える",
    services: "リクルートエージェント",
    reason: "求人紹介、職務経歴書、面接対策をまとめて相談しやすい"
  },
  {
    title: "まず市場価値を知りたい",
    services: "ビズリーチ",
    reason: "スカウト反応から、自分の経験がどの職種・年収帯に見えるか確認しやすい"
  },
  {
    title: "管理職・専門職経験を試したい",
    services: "ビズリーチ / JAC Recruitment",
    reason: "マネジメント、企画、専門性、年収レンジをスカウトや専門エージェントで確認しやすい"
  },
  {
    title: "公共領域・BtoG企業を見たい",
    services: "リクルートエージェント / ビズリーチ / JAC Recruitment",
    reason: "公共系企業、自治体向けSaaS、コンサル、官民連携領域を探しやすい"
  },
  {
    title: "福祉・保健・介護経験を広く見たい",
    services: "リクルートエージェント",
    reason: "ヘルスケア、介護、福祉、人材、カスタマーサクセスなど候補を相談しやすい"
  },
  {
    title: "土木・建築・インフラ経験を活かしたい",
    services: "リクルートエージェント / ビズリーチ / JAC Recruitment",
    reason: "建設、インフラ、発注者支援、PPP/PFI、施設管理領域を確認しやすい"
  }
];

const comparison = [
  ["求人紹介を受ける", "強い", "サービス内で接点あり", "強い"],
  ["スカウトを受ける", "あり", "強い", "求人紹介中心"],
  ["初めての転職相談", "向いている", "経験整理後に向く", "経験整理後に向く"],
  ["管理職・専門職", "求人次第", "向いている", "向いている"],
  ["市場価値確認", "求人紹介で確認", "スカウトで確認", "専門エージェントへの相談で確認"]
];
---
<BaseLayout title="転職サービス比較" description="地方公務員の行政経験を民間キャリアにつなげるための主要転職サービス比較。総合型、スカウト型、行政経験別の使い分けを整理します。">
<div class="container article">
  <p class="eyebrow">SERVICES</p>
  <h1>地方公務員向け<br />転職サービス比較</h1>
  <p class="lead">地方公務員から民間企業への転職では、求人紹介だけでなく「経験の棚卸し」と「職種の翻訳」が重要です。まずは大手サービスで求人の幅とスカウト反応を確認し、自分の行政経験がどの職種に接続するかを見ていきます。</p>

  <KeyPoints title="このページで選べること" points={[
    "初めての転職相談、市場価値確認、管理職・専門職向けでサービスを分ける",
    "行政経験別に、どのサービスで確認しやすいかを見る",
    "登録後に求人票やスカウトで確認すべきポイントを整理する"
  ]} />

  <div class="notice"><strong>掲載方針：</strong>このページには広告リンクを含みます。主ボタンは登録・申込み導線、各カード内の小さなリンクは公式情報への確認導線です。</div>

  <h2>登録は、転職を決めることではない</h2>
  <p>公務員は、民間の転職サービスに登録した経験がない人も少なくありません。そのため「登録したら、すぐ応募しなければいけない」「職場に知られるのではないか」と不安になりやすいところがあります。</p>
  <p>しかし最初の目的は、転職を決めることではなく情報収集です。求人票、スカウト、エージェントとの面談に触れることで、行政経験が民間ではどの職種名・スキル名で表現されるのかが見えてきます。</p>
  <div class="grid-list">
    <a href="#major-services"><b>求人票を見る</b><span>必要経験、年収帯、職種名から自分との差分を知る</span></a>
    <a href="#major-services"><b>スカウト反応を見る</b><span>企画、調整、管理職、専門性がどう評価されるか確認する</span></a>
    <a href="#before-register"><b>職務経歴を言語化する</b><span>担当業務を、課題・行動・成果の言葉に置き換える</span></a>
  </div>

  <h2>迷ったらこの組み合わせ</h2>
  <p>地方公務員から民間を考える場合、最初から1社に絞る必要はありません。総合エージェントで求人の幅を見て、スカウト型で市場からの反応を見ると、経験を言語化する材料が増えます。</p>
  <div class="grid-list">
    <a href="#major-services"><b>まず情報収集したい</b><span>リクルートエージェント</span></a>
    <a href="#major-services"><b>自分の市場価値を試したい</b><span>ビズリーチ</span></a>
    <a href="#major-services"><b>管理職・専門性を相談したい</b><span>ビズリーチ + JAC Recruitment</span></a>
    <a href="#before-register"><b>まだ登録が不安</b><span>先に職務経歴書の見出しだけ作る</span></a>
  </div>

  <h2>目的別に選ぶ</h2>
  <p>行政経験は、部署名だけでは民間企業に伝わりにくいことがあります。まず「何を確認したいのか」を決めてからサービスを選ぶと、登録後の迷いが減ります。</p>
  <div class="grid-list">
    {purposes.map((purpose) => (
      <a href="#major-services">
        <b>{purpose.title}</b>
        <span>{purpose.services} / {purpose.reason}</span>
      </a>
    ))}
  </div>

  <h2 id="major-services">まず登録候補にしやすい大手サービス</h2>
  <p>迷う場合は、総合エージェントを1つ、スカウト型を1つ登録して、求人紹介とスカウト反応の両方を見ると判断材料が増えます。</p>

  {services.map((service) => (
    <section class="service-card">
      <div>
        <span class="tag">{service.type}</span>
        <h2>{service.name}</h2>
        <p>{service.point}</p>
        <p class="small"><strong>向いている人：</strong>{service.fit}</p>
        <p class="small"><strong>つながりやすい行政経験：</strong>{service.admin}</p>
      </div>
      <div class="service-actions">
        <a class="button" href={service.url} rel={service.trackingPixel ? "nofollow sponsored" : "nofollow"}>
          {service.trackingPixel && (
            <img class="tracking-pixel" src={service.trackingPixel} height="1" width="1" alt="" />
          )}
          {service.actionText}
        </a>
        <a class="text-link" href={service.officialUrl}>公式情報</a>
      </div>
    </section>
  ))}

  <h2>主要サービスの比較</h2>
  <p>サービスごとに得意な使い方が違います。求人紹介を受けたいのか、求人を自分で見たいのか、スカウト反応を見たいのかで選びます。</p>
  <div class="grid-list">
    {comparison.map(([theme, recruit, bizreach, jac]) => (
      <a href="#major-services">
        <b>{theme}</b>
        <span>リクルートエージェント: {recruit} / ビズリーチ: {bizreach} / JAC Recruitment: {jac}</span>
      </a>
    ))}
  </div>

  <h2>行政経験別の使い分け</h2>
  <p>部署名そのものよりも、経験を民間職種に翻訳したうえでサービスを選ぶと、求人検索やスカウトの精度が上がります。</p>
  <div class="grid-list">
    {routes.map(([department, service, use]) => (
      <a href="/articles/skill-map/">
        <b>{department}</b>
        <span>{service} / {use}</span>
      </a>
    ))}
  </div>

  <h2>登録後に見るべきポイント</h2>
  <p>登録して終わりではなく、求人票やスカウトから「自分の経験がどう見られているか」を確認します。</p>
  <ul>
    <li>行政経験が、どの職種名に置き換えられているか</li>
    <li>年収、勤務地、働き方の条件が現実的か</li>
    <li>公共領域、BtoG、DX、福祉、インフラなど近い領域の求人があるか</li>
    <li>職務経歴書で伝わりにくい経験がどこか</li>
    <li>今すぐ転職するのか、学習してから動くのか</li>
  </ul>

  <h2 id="before-register">登録前に整理しておくこと</h2>
  <div class="grid-list">
    <a href="/articles/local-government-resume"><b>職務経歴書の土台を作る</b><span>担当業務ではなく、課題・行動・成果で整理する</span></a>
    <a href="/articles/local-government-market-value"><b>市場価値を確認する</b><span>求人票とスカウトから評価される経験を探す</span></a>
    <a href="/articles/local-government-job-view-first"><b>求人を見るだけから始める</b><span>転職を決める前に選択肢を増やす</span></a>
    <a href="/learning/"><b>不足する専門性を学ぶ</b><span>現職継続と転職準備の両方に効く資格・書籍を見る</span></a>
  </div>
</div>
</BaseLayout>
