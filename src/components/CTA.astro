---
const pathname = Astro.url.pathname;

const defaultPreset = {
  title: "まず登録して、求人情報に触れてみる",
  text: "登録は転職を決めることではありません。求人票やスカウトを見ることで、自分の行政経験を民間で伝わる言葉に直す練習になります。",
  buttonText: "登録候補を比較する"
};

const preset = pathname.includes("/articles/department")
  ? {
      title: "この行政経験を、実際の求人で確認する",
      text: "求人票を見ないままだと、自分の経験がどの職種に近いのか判断しにくいものです。登録後に求人やスカウトに触れることで、経験を言語化しやすくなります。",
      buttonText: "登録候補を比較する"
    }
  : pathname.includes("/articles/career-") || pathname.includes("/articles/public-servant-")
    ? {
        title: "気になる職種は、求人票で確かめる",
        text: "応募前の情報収集でも、登録して求人票を見る価値があります。必要経験、年収帯、足りないスキルが見えると、自分の強みを言葉にしやすくなります。",
        buttonText: "登録候補を比較する"
      }
    : pathname.includes("/articles/local-government")
      ? {
          title: "転職を決める前に、まず登録して情報収集する",
          text: "公務員は転職サービスに慣れていない人も多いですが、登録は退職の意思表示ではありません。求人やスカウトを見ながら、自分の経験を言語化するための第一歩です。",
          buttonText: "登録候補を比較する"
        }
      : defaultPreset;

const { title = preset.title, text = preset.text, buttonText = preset.buttonText } = Astro.props;
---
<section class="cta">
  <div>
    <p class="eyebrow">NEXT STEP</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="button" href="/services/">{buttonText}</a>
</section>
