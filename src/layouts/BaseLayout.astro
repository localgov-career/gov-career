---
import "../styles/global.css";
import { siteUrl, siteName } from "../data/site.js";
const { title, description = `${title}。地方公務員の経験を整理し、現職での成長・学習・民間転職の選択肢を考えるためのガイドです。`, updatedDate } = Astro.props;
const canonical = new URL(`${Astro.url.pathname.replace(/\/$/, "")}/`, siteUrl).href;
const fullTitle = `${title} | ${siteName}`;
const isArticle = /^\/(articles|blog)\/.+/.test(Astro.url.pathname);
const navigation = [
  ["/articles/", "悩みから探す"],
  ["/articles/skill-map/", "行政経験から探す"],
  ["/articles/career-options/", "職種から探す"],
  ["/articles/current-role-growth/", "現職で成長する"],
  ["/learning/", "資格・書籍"],
  ["/blog/", "ブログ"],
  ["/services/", "転職サービス比較"]
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL("/og-default.png", siteUrl).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="地方公務員キャリア — 経験を整理し、これからの選択肢を増やす" />
  <meta name="twitter:card" content="summary_large_image" />
  {isArticle && updatedDate && <meta property="article:modified_time" content={`${updatedDate}T00:00:00+09:00`} />}
</head>
<body>
<a class="skip-link" href="#main-content">本文へ進む</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">地方公務員<span>キャリア</span></a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {navigation.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>)}
    </nav>
    <details class="site-menu">
      <summary aria-label="メニュー">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="モバイルナビゲーション">
        {navigation.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>

<main id="main-content" tabindex="-1">
  {updatedDate && <p class="container page-meta">内容更新：<time datetime={updatedDate}>{updatedDate.replaceAll("-", "/")}</time></p>}
  <slot />
  {isArticle && <aside class="container editorial-note"><a href="/editorial-policy/">編集・広告掲載方針</a><p>経験の整理や職種の例は、キャリアを検討するための提案です。制度・サービスの条件は、本文の参考資料と各機関の公式案内を確認してください。</p></aside>}
</main>
<footer>
  <div class="container footer-inner">
    <section class="footer-brand">
      <a class="footer-logo" href="/">地方公務員<span>キャリア</span></a>
      <p>公務員として培った行政経験を、民間でも伝わるスキルと職種に変換するためのキャリア情報サイトです。</p>
      <a class="footer-cta" href="/services/">転職サービスを比較する</a>
    </section>

    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <section>
        <h2>まず読む</h2>
        <ul>
          <li><a href="/articles/current-role-growth/">現職で成長する</a></li>
          <li><a href="/articles/why-public-servants-dont-change/">転職したいが動けない</a></li>
          <li><a href="/articles/local-government-market-value">市場価値を知る</a></li>
          <li><a href="/articles/local-government-job-view-first">求人を見てみる</a></li>
          <li><a href="/learning/">資格・書籍で学ぶ</a></li>
          <li><a href="/blog/site-purpose/">このサイトの目的</a></li>
          <li><a href="/articles/local-government-first-five">最初にやる5つのこと</a></li>
        </ul>
      </section>

      <section>
        <h2>経験から探す</h2>
        <ul>
          <li><a href="/articles/skill-map/">行政経験を整理する</a></li>
          <li><a href="/articles/administrative-stakeholder-coordination">関係者調整</a></li>
          <li><a href="/articles/administrative-budget">予算・事業管理</a></li>
          <li><a href="/articles/administrative-data">データ活用</a></li>
        </ul>
      </section>

      <section>
        <h2>部門別</h2>
        <ul>
          <li><a href="/articles/department-planning-policy">企画・政策</a></li>
          <li><a href="/articles/department-finance-accounting">財務・会計</a></li>
          <li><a href="/articles/department-tax">税務・徴収</a></li>
          <li><a href="/articles/department-long-term-care">介護保険</a></li>
          <li><a href="/articles/department-digital">情報・DX</a></li>
        </ul>
      </section>

      <section>
        <h2>職種・運営情報</h2>
        <ul>
          <li><a href="/articles/career-options/">民間職種一覧</a></li>
          <li><a href="/articles/career-consulting">コンサルタント</a></li>
          <li><a href="/articles/career-public-business">公共系企業</a></li>
          <li><a href="/learning/">資格・書籍</a></li>
          <li><a href="/blog/">ブログ</a></li>
          <li><a href="/editorial-policy/">運営方針・掲載方針</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
          <li><a href="/disclaimer/">免責事項・広告掲載方針</a></li>
          <li><a href="/articles/">記事一覧</a></li>
        </ul>
      </section>
    </nav>
  </div>
</footer>
</body>
</html>
