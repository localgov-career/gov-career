---
const pathname = Astro.url.pathname;

const defaultPreset = {
  title: "今の自分に合う、次の一歩を選ぶ",
  text: "現職で経験を積む、学習する、民間の仕事を調べる。今の目的に合うものを一つ選び、できることから始めましょう。",
  buttonText: "経験を整理する"
};

const preset = pathname.includes("/articles/department")
  ? {
      title: "この行政経験につながる仕事を調べる",
      text: "公開求人の仕事内容と応募条件を読み、自分の担当経験との接点を整理します。相談が必要になったら、転職サービスの使い方を比較できます。",
      buttonText: "転職サービスの使い方を見る"
    }
  : pathname.includes("/articles/career-") || pathname.includes("/articles/public-servant-")
    ? {
        title: "気になる職種は、求人票で確かめる",
        text: "公開求人から、必要経験や仕事内容を確認できます。今の経験が合う点と、これから身につけたいスキルを分けてみましょう。",
        buttonText: "転職サービスの使い方を見る"
      }
    : pathname.includes("/articles/local-government")
      ? {
          title: "転職を決める前に、仕事内容を調べる",
          text: "公開求人や企業の採用ページで、仕事内容と応募条件を確認できます。個別に相談したくなったら、必要な支援と利用条件を比べましょう。",
          buttonText: "転職サービスの使い方を見る"
        }
      : defaultPreset;

const { title = preset.title, text = preset.text, buttonText = preset.buttonText, href = preset === defaultPreset ? "/articles/skill-map/" : "/services/" } = Astro.props;
---
<section class="cta">
  <div>
    <p class="eyebrow">NEXT STEP</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="button" href={href}>{buttonText}</a>
</section>
<div class="grid-list next-options" aria-label="目的に合わせた次の行動">
  <a href="/articles/current-role-growth/"><b>現職で成長する</b><span>業務改善・異動希望・学習を計画する</span></a>
  <a href="/learning/"><b>学習から始める</b><span>今の業務に必要な知識を補う</span></a>
  <a href="/services/"><b>民間の仕事を調べる</b><span>公開求人や転職サービスを比較する</span></a>
</div>
